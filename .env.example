# Copy to .env to override defaults. All values below are the built-in defaults,
# so an out-of-the-box local run needs no .env file at all.

# Express backend root (no trailing slash)
API_BASE_URL=http://localhost:3000

# React dev server root (no trailing slash)
UI_BASE_URL=http://localhost:4101

# API prefix mounted by the backend
API_PATH=/api

# Password applied to every generated test user.
# Not a secret: the app under test is a disposable local sandbox.
# Kept in env so no credential literal is hardcoded in test code.
TEST_USER_PASSWORD=Passw0rd!23

# Timeouts (milliseconds)
API_TIMEOUT_MS=15000
UI_EXPECT_TIMEOUT_MS=10000
